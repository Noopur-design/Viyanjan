# Database — SQLite for local dev (zero-config; file lives at prisma/dev.db).
# For production, switch provider in prisma/schema.prisma to mysql/postgresql
# and point DATABASE_URL at the hosted DB, e.g.:
#   DATABASE_URL="mysql://USER:PASSWORD@srv1556.hstgr.io:3306/DBNAME"
DATABASE_URL="file:./dev.db"

# ---- Order-confirmation email (Hostinger SMTP) ----
# Create a mailbox in hPanel → Emails, then fill these in.
# Leave unset to disable emails (orders still work).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="orders@yourdomain.com"
SMTP_PASS="your-mailbox-password"
SMTP_FROM="Viyanjan <orders@yourdomain.com>"

# ---- Admin auth (protects /admin and admin/PII API routes) ----
ADMIN_PASSWORD="set-a-strong-password"
ADMIN_TOKEN="set-a-long-random-string"
